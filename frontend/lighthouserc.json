{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/central/resumen",
        "http://localhost:4173/central/suscripciones",
        "http://localhost:4173/virtualpos/resumen",
        "http://localhost:4173/central/clientes",
        "http://localhost:4173/central/cobros"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median" }]
      }
    }
  }
}

exports[`Dashboard de canal (/virtualpos/resumen) > pide dashboard/{canal} una vez y muestra el resumen operativo con los accesos a recursos 1`] = `"<main class="app-shell channel-dashboard-page"><p class="eyebrow">VIRTUALPOS</p><header class="channel-hero"><div><h2>Resumen operativo </h2><p>Indicadores y actividad del período seleccionado.</p></div><div class="channel-hero-controls"><div class="dashboard-controls"><div class="mode-switch"><button class="active">Cantidad</button><button class="">Monto</button></div><select aria-label="Año"><option value="2024">2024</option><option value="2025">2025</option></select></div><div class="channel-hero-bottom-row"><div class="sync-state ready"><span></span>Sincronización completada</div><button class="sync-btn ">↻ Sincronizar</button><button class="sync-btn sync-btn-secondary">Generar reporte</button></div></div></header><section class="channel-resources channel-resources-quick" aria-label="Explorar recursos"><div><p class="eyebrow">EXPLORAR</p><h3>Ir a un recurso</h3></div><div><button>Clientes<span>500</span></button><button>Planes<span>5</span></button><button>Subscripciones<span>300</span></button><button>Cargos<span>150</span></button><button>Transacciones<span>100</span></button></div></section><div class="dashboard-section-heading"><div><p class="eyebrow">OPERACIÓN DEL PERÍODO</p><h3>Indicadores clave</h3></div></div><section class="metrics provider-metrics vp-metrics" aria-label="Métricas VirtualPOS"><article class="metric-card" style="--accent: #4a90c4;"><p class="metric-label">Clientes</p><strong class="metric-value">500</strong></article><article class="metric-card" style="--accent: #7b6cc7;"><p class="metric-label">Planes</p><strong class="metric-value">5</strong></article><article class="metric-card" style="--accent: #c49d30;"><p class="metric-label">Subscripciones Activas</p><strong class="metric-value">300</strong><span class="metric-amount">$0</span></article><article class="metric-card" style="--accent: #2ab8a8;"><p class="metric-label">Subscripciones Cobrables</p><strong class="metric-value">0</strong><span class="metric-amount">$0</span></article><article class="metric-card" style="--accent: #d46a2a;"><p class="metric-label">Cargos Pagados</p><strong class="metric-value">90</strong><span class="metric-amount">$900.000</span></article><article class="metric-card" style="--accent: #3ba675;"><p class="metric-label">Transacciones Pagadas</p><strong class="metric-value">80</strong><span class="metric-amount">$800.000</span></article></section><div class="dashboard-section-heading dashboard-section-heading-compact"><div><p class="eyebrow">CARTERA</p><h3>Salud de suscripciones</h3></div></div><section class="metrics kpi-metrics kpi-strip" aria-label="KPIs de suscripciones"><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">MRR</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">$3.000.000</strong></div><span class="metric-amount">Ingreso mensual recurrente activo</span></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">ARPU</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">$12.000</strong></div><span class="metric-amount">240 clientes con subs activas</span></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Suscriptores activos</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">250</strong></div></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Churn</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">2,5%</strong></div></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Cargos rechazados</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono" role="img" aria-label="sin datos">—</strong></div></article></section><section class="channel-workspace channel-workspace-status"><article class="panel status-panel"><p class="eyebrow">ESTADOS</p><h3>Estados de la operación</h3><div class="status-bars"><div class="status-bar-row"><div class="status-bar-header"><span>Clientes</span><b class="mono">500</b></div><div class="status-bar-track"><div class="status-bar-segment status-bar-empty"></div></div></div><div class="status-bar-row"><div class="status-bar-header"><span>Subscripciones</span><b class="mono">300</b></div><div class="status-bar-track"><div data-status-kind="paid" class="status-bar-segment" style="width: 83.33333333333334%; background: var(--status-paid);" title="ACTIVA: 250"></div><div data-status-kind="neutral" class="status-bar-segment" style="width: 16.666666666666664%; background: var(--status-neutral);" title="CANCELADA: 50"></div></div><div class="status-bar-legend"><span class="status-legend-item"><i data-status-kind="paid" style="background: var(--status-paid);"></i>ACTIVA<b class="mono">250</b></span><span class="status-legend-item"><i data-status-kind="neutral" style="background: var(--status-neutral);"></i>CANCELADA<b class="mono">50</b></span></div></div><div class="status-bar-row"><div class="status-bar-header"><span>Cargos</span><b class="mono">150</b></div><div class="status-bar-track"><div class="status-bar-segment status-bar-empty"></div></div></div><div class="status-bar-row"><div class="status-bar-header"><span>Transacciones</span><b class="mono">100</b></div><div class="status-bar-track"><div class="status-bar-segment status-bar-empty"></div></div></div><div class="status-bar-row"><div class="status-bar-header"><span>Planes</span><b class="mono">5</b></div><div class="status-bar-track"><div class="status-bar-segment status-bar-empty"></div></div></div></div></article></section><div class="dashboard-section-heading dashboard-section-heading-charts"><div><p class="eyebrow">ACTIVIDAD Y TENDENCIAS</p><h3>Lectura mensual</h3></div></div><section class="extended-charts"><article class="panel chart-panel-wide"><div class="panel-heading"><div><p class="eyebrow">CARGOS</p><h3>Estado mensual</h3></div></div><div class="channel-chart"><div role="img" aria-label="Gráfico de cargos mensuales por estado"><div class="recharts-responsive-container" style="width: 100%; height: 280px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div></div></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">TRANSACCIONES</p><h3>Estado mensual</h3></div></div><div class="channel-chart"><div role="img" aria-label="Gráfico de transacciones mensuales por estado"><div class="recharts-responsive-container" style="width: 100%; height: 280px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div></div></article></section><section class="panel dashboard-alerts-panel"><div class="panel-heading"><p class="eyebrow">ALERTAS OPERATIVAS</p></div><p style="margin: 0px; color: var(--text-muted); font-size: 0.875rem;">✓ Sin alertas operativas — todo en orden.</p></section></main>"`;

exports[`Lista VirtualPOS: clientes (/virtualpos/clientes) > pide la lista (source, resource_type, offset, limit) y muestra columnas, filas, contador y botón de alta 1`] = `"<main class="app-shell detail-page provider-page"><button class="back-button">Volver al resumen VirtualPOS</button><p class="eyebrow">VIRTUALPOS / STAGING</p><h2>Clientes</h2><div class="vp-platform-filter"><button class="vp-platform-btn active">Todas</button><button class="vp-platform-btn">VP 1</button><button class="vp-platform-btn">VP 2</button><button class="clear-filter-button" disabled="">Limpiar filtros</button></div><section class="panel provider-panel"><div class="panel-heading"><div><p class="eyebrow">SOURCE RECORDS</p><h3>Payloads saneados almacenados localmente</h3></div><span aria-live="polite">2 registros</span><div class="export-button"><button type="button" class="export-trigger" aria-haspopup="menu" aria-expanded="false" aria-busy="false"><span aria-hidden="true">↓</span> Exportar</button><span class="export-status" role="status" aria-live="polite"></span></div></div><button class="new-client-button">+ Nuevo cliente</button><div class="table-wrap"><table><thead><tr><th><button class="table-sort-button" title="Ordenar por RUT">RUT<span class="table-sort-indicator" aria-hidden="true">↕</span></button></th><th><button class="table-sort-button" title="Ordenar por Nombre">Nombre<span class="table-sort-indicator" aria-hidden="true">↕</span></button></th><th><button class="table-sort-button" title="Ordenar por Email">Email<span class="table-sort-indicator" aria-hidden="true">↕</span></button></th><th><button class="table-sort-button" title="Ordenar por Telefono">Telefono<span class="table-sort-indicator" aria-hidden="true">↕</span></button></th><th>Plataforma</th><th><button class="table-sort-button" title="Ordenar por Estado">Estado<span class="table-sort-indicator" aria-hidden="true">↕</span></button></th><th>Acciones</th></tr><tr class="table-column-filters"><th><input aria-label="B
exports[`TCH: resumen (/tch/resumen) > pide el resumen y muestra encabezado, KPIs, tarjetas, gráficos y accesos a las vistas 1`] = `"<main class="app-shell channel-dashboard-page"><p class="eyebrow">TCH / CANAL</p><header class="channel-hero"><div><h2>Resumen operativo </h2><p>Datos cargados desde reportes Excel mensuales vía ETL.</p></div><div class="channel-hero-controls"><div class="dashboard-controls"><div class="mode-switch"><button class="active">Cantidad</button><button class="">Monto</button></div><select aria-label="Año TCH"><option value="2024">2024</option><option value="2025">2025</option></select></div><div class="channel-hero-bottom-row"><div class="sync-state ready"><span></span>Completada</div><button class="sync-btn sync-btn-secondary">Generar reporte</button></div><p class="muted-copy" style="font-size: 0.78rem;">Último ETL: 2025-03-31 · 1.234 registros</p></div></header><section class="channel-resources channel-resources-quick" aria-label="Explorar recursos"><div><p class="eyebrow">EXPLORAR TCH</p><h3>Vistas disponibles</h3></div><div><button>Suscripciones<span>50</span></button><button>Transacciones<span>200</span></button></div></section><div class="dashboard-section-heading"><div><p class="eyebrow">OPERACIÓN DEL PERÍODO</p><h3>Indicadores clave</h3></div></div><section class="metrics provider-metrics" aria-label="KPIs TCH"><article class="metric-card" style="--accent: #3ba675;"><p class="metric-label">Suscripciones vigentes</p><strong class="metric-value">40</strong><span class="metric-amount">$400.000</span></article><article class="metric-card" style="--accent: #d46a2a;"><p class="metric-label">Suscripciones eliminadas</p><strong class="metric-value">10</strong><span class="metric-amount">$100.000</span></article><article class="metric-card" style="--accent: #4a90c4;"><p class="metric-label">Total suscripciones</p><strong class="metric-value">50</strong><span class="metric-amount">$500.000</span></article><article class="metric-card" style="--accent: #7b6cc7;"><p class="metric-label">Total transacciones</p><strong class="metric-value">200</strong><span class="metric-amount">$1.800.000</span></article></section><section class="metrics kpi-metrics" aria-label="KPIs transacciones TCH"><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Aceptadas</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">180</strong></div><span class="metric-amount">Transacciones cobradas</span></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Rechazadas</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">20</strong></div><span class="metric-amount">Transacciones fallidas</span></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Tasa de rechazo</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">10%</strong></div><span class="metric-amount">Rechazadas / total</span></article></section><div class="dashboard-section-heading dashboard-section-heading-compact"><div><p class="eyebrow">CARTERA</p><h3>Salud de suscripciones</h3></div></div><section class="metrics kpi-metrics kpi-strip" aria-label="KPIs financieros TCH"><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">MRR</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">$400.000</strong></div><span class="metric-amount">Ingreso mensual recurrente activo</span></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">ARPU</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">$10.000</strong></div><span class="metric-amount">38 clientes con subs activas</span></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Suscriptores activos</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono">40</strong></div></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Churn</p><span class="kpi-chip none"><span class="kpi-chip-dot" aria-hidden="true"></span>sin meta</span></div><div class="kpi-main"><strong class="metric-value kpi-value mono">2,5%</strong></div><p class="kpi-help">Bajas del mes ÷ socios al inicio del mes</p></article><article class="metric-card kpi-card" data-variant="normal"><div class="kpi-head"><p class="metric-label">Cargos rechazados</p></div><div class="kpi-main"><strong class="metric-value kpi-value mono" role="img" aria-label="sin datos">—</strong></div></article></section><p class="kpi-note muted-copy">Fuente: reportes Excel oficiales</p><div class="dashboard-section-heading dashboard-section-heading-charts"><div><p class="eyebrow">ACTIVIDAD Y TENDENCIAS</p><h3>Lectura mensual</h3></div></div><section class="extended-charts"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">CARGOS</p><h3>Transacciones mensuales</h3></div></div><div class="channel-chart"><div class="chart-plot" tabindex="0" role="group" aria-roledescription="gráfico" aria-label="Gráfico de transacciones mensuales de TCH por estado (recorrer con flechas)" aria-describedby="_r_3_"><div role="img" aria-label="Gráfico de transacciones mensuales de TCH por estado"><div class="recharts-responsive-container" style="width: 100%; height: 280px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div></div><p id="_r_3_" class="sr-only">Flechas izquierda y derecha: mes anterior o siguiente. Inicio y Fin: primer y último mes. Escape: soltar.</p><p class="chart-readout mono" aria-live="polite" aria-atomic="true"></p><button type="button" class="chart-data-toggle" aria-expanded="false" aria-controls="_r_2_">Ver datos</button><div id="_r_2_" class="chart-data" role="region" aria-label="Gráfico de transacciones mensuales de TCH por estado: datos" tabindex="0" hidden=""></div></div><p class="muted-copy">Fuente: respaldo desde transacciones individuales (sin reporte mensual oficial)</p></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">SUSCRIPCIONES</p><h3>Altas vs bajas</h3></div></div><div class="channel-chart"><div class="chart-plot" tabindex="0" role="group" aria-roledescription="gráfico" aria-label="Gráfico de altas (arriba) y bajas (abajo) mensuales de suscripciones TCH (recorrer con flechas)" aria-describedby="_r_5_"><div role="img" aria-label="Gráfico de altas (arriba) y bajas (abajo) mensuales de suscripciones TCH"><div class="recharts-responsive-container" style="width: 100%; height: 280px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div></div><p id="_r_5_" class="sr-only">Flechas izquierda y derecha: mes anterior o siguiente. Inicio y Fin: primer y último mes. Escape: soltar.</p><p class="chart-readout mono" aria-live="polite" aria-atomic="true"></p><button type="button" class="chart-data-toggle" aria-expanded="false" aria-controls="_r_4_">Ver datos</button><div id="_r_4_" class="chart-data" role="region" aria-label="Gráfico de altas (arriba) y bajas (abajo) mensuales de suscripciones TCH: datos" tabindex="0" hidden=""></div></div></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">SUSCRIPCIONES</p><h3>Crecimiento real mensual</h3></div></div><div class="channel-chart"><div class="chart-plot" tabindex="0" role="group" aria-roledescription="gráfico" aria-label="Waterfall del crecimiento neto mensual de TCH (altas menos bajas) (recorrer con flechas)" aria-describedby="_r_7_"><div role="img" aria-label="Waterfall del crecimiento neto mensual de TCH (altas menos bajas)"><div class="recharts-responsive-container" style="width: 100%; height: 280px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div></div><p id="_r_7_" class="sr-only">Flechas izquierda y derecha: mes anterior o siguiente. Inicio y Fin: primer y último mes. Escape: soltar.</p><p class="chart-legend" aria-hidden="true"><span><i style="background: var(--flow-in);"></i>Sube</span><span><i style="background: var(--flow-out);"></i>Baja</span></p><p class="chart-readout mono" aria-live="polite" aria-atomic="true"></p><button type="button" class="chart-data-toggle" aria-expanded="false" aria-controls="_r_6_">Ver datos</button><div id="_r_6_" class="chart-data" role="region" aria-label="Waterfall del crecimiento neto mensual de TCH (altas menos bajas): datos" tabindex="0" hidden=""></div></div><p class="muted-copy">Cada barra es altas menos bajas del mes, desde el acumulado del mes anterior del período.</p></article><article class="panel"><div class="panel-heading"><div><p class="eyebrow">SUSCRIPCIONES</p><h3>Churn mensual (%)</h3></div></div><div class="channel-chart"><div class="chart-plot" tabindex="0" role="group" aria-roledescription="gráfico" aria-label="Gráfico del churn mensual de TCH en porcentaje (recorrer con flechas)" aria-describedby="_r_9_"><div role="img" aria-label="Gráfico del churn mensual de TCH en porcentaje"><div class="recharts-responsive-container" style="width: 100%; height: 280px; min-width: 0px;"><div style="width: 0px; overflow-x: visible;"></div></div></div></div><p id="_r_9_" class="sr-only">Flechas izquierda y derecha: mes anterior o siguiente. Inicio y Fin: primer y último mes. Escape: soltar.</p><p class="chart-readout mono" aria-live="polite" aria-atomic="true"></p><button type="button" class="chart-data-toggle" aria-expanded="false" aria-controls="_r_8_">Ver datos</button><div id="_r_8_" class="chart-data" role="region" aria-label="Gráfico del churn mensual de TCH en porcentaje: datos" tabindex="0" hidden=""></div></div><p class="muted-copy">Bajas del mes ÷ socios al inicio del mes (misma definición en todos los canales).</p></article></section><section class="panel" aria-label="Archivos TCH car
s="table-column-filters"><th><input aria-label="Buscar por RUT cliente" placeholder="Buscar" value=""></th><th><input aria-label="Buscar por Estado" placeholder="Buscar" value=""></th><th><input aria-label="Buscar por Estado sec." placeholder="Buscar" value=""></th><th class="range-filter"><input aria-label="Monto mínimo" placeholder="Mín." type="number" value=""><input aria-label="Monto máximo" placeholder="Máx." type="number" value=""></th><th class="range-filter"><input aria-label="F. Inicio desde" type="date" value=""><input aria-label="F. Inicio hasta" type="date" value=""></th><th class="range-filter"><input aria-label="F. Cancelacion desde" type="date" value=""><input aria-label="F. Cancelacion hasta" type="date" value=""></th><th></th><th></th><th></th></tr></thead><tbody><tr><td><button class="record-link" aria-label="Ver ficha de subscripción 11111111-1">11111111-1</button></td><td>ACTIVA</td><td><span class="badge badge-green">cobrable</span></td><td>$10.000</td><td>2025-01-10</td><td>Sin dato</td><td>2025-03-05</td><td>VP 1</td><td><div class="table-actions-group"><button class="cancel-subscription-button cancel-subscription-button-table">Cancelar Sub</button><button class="create-charge-button create-charge-button-table">+ Cargo</button></div></td></tr></tbody></table></div></section></main>
<div class="edit-dialog-backdrop" role="presentation"><form class="edit-dialog" aria-modal="true" aria-label="Crear cargo VirtualPOS" novalidate=""><div class="edit-dialog-heading"><div><p class="eyebrow">VIRTUALPOS / CARGO</p><h3>Nuevo cargo</h3></div><span class="edit-dialog-subtitle">Sub: sub-1</span></div><p class="edit-dialog-note">Los campos marcados con * son obligatorios. La fecha del cargo no puede ser pasada.</p><div class="edit-form-grid"><label class="">Fecha del cargo<span class="field-required" aria-hidden="true"> *</span><input aria-required="true" aria-invalid="false" min="HOY" type="date" name="charge_date"></label><label class="">Monto<span class="field-required" aria-hidden="true"> *</span><input min="1" step="1" placeholder="Ej: 9990" aria-required="true" aria-invalid="false" type="number" name="amount"></label><label>Descripción<input placeholder="Ej: Cuota agosto 2026" type="text" name="description"></label><label>Código interno<input placeholder="Ej: AGO2026" type="text" name="internal_code"></label></div><div class="edit-dialog-actions"><button type="submit" class="save-button">Crear cargo</button><button type="button" class="cancel-button">Cancelar</button></div></form></div>"
`;


exports[`Clientes consolidados (/central/clientes) > la ficha general pide el detalle por RUT y permite volver 1`] = `"<main class="app-shell portfolio-page"><header class="topbar"><div><p class="eyebrow">Cartera</p><h1>Socios</h1></div><div class="sync-state ready"><span></span>Test</div></header><section class="panel"><div class="panel-heading sr-only"><div><p class="eyebrow">Cartera</p><h3>Listado de socios</h3></div></div><div class="filter-bar portfolio-filters"><div class="portfolio-filter-primary"><label class="filter-field portfolio-search"><span>Buscar socios</span><span class="portfolio-search-input"><input aria-label="Buscar socios" placeholder="Nombre, RUT, correo o teléfono" aria-describedby="react-id-1" type="search" value=""></span><small id="react-id-1" class="sr-only">Busca en todos los campos. Los resultados se actualizan al escribir.</small></label><label class="filter-field"><span>Canal</span><select aria-label="Canal de los socios"><option value="">Todos los canales</option><option value="virtualpos">VirtualPOS</option><option value="toku">Toku</option><option value="payku">Payku</option><option value="tch">TCH</option></select></label><fieldset class="filter-actions portfolio-export"><legend class="sr-only">Exportación</legend><div class="export-button"><button type="button" class="export-trigger" aria-haspopup="menu" aria-expanded="false" aria-busy="false"><span aria-hidden="true">↓</span> Exportar</button><span class="export-status" role="status" aria-live="polite"></span></div></fieldset></div><details class="portfolio-more-filters"><summary>Más filtros </summary><div class="filter-fields" hidden=""><label class="filter-field"><span>Buscar en</span><select aria-label="Buscar en"><option value="all">Todos los campos</option><option value="rut">RUT</option><option value="name">Nombre</option><option value="last_name">Apellido</option><option value="platform">Plataforma</option><option value="email">Correo</option><option value="phone">Teléfono</option></select></label><label class="filter-field"><span>Estado</span><select aria-label="Estado de los socios"><option value="">Todos</option><option value="active">Con suscripción activa</option><option value="inactive">Sin suscripción activa</option></select></label></div></details><div class="filter-summary"><p class="filter-count" aria-live="polite"><span class="mono">250</span> socios</p></div></div><aside class="member-identity-note"><p>Agrupación por RUT · Identidad sin confirmar</p><details><summary>Qué significa</summary><p>Agrupado por RUT <strong>no verificado</strong>: un RUT compartido entre canales se agrupa, pero no confirma que corresponda a la misma persona. La identidad centralizada sigue pendiente.</p></details></aside><section class="record-detail member-detail" aria-labelledby="member-detail-title"><div class="member-detail-heading"><div><h2 id="member-detail-title" tabindex="-1">Persona Sintética 1</h2><p>RUT: <span class="mono rut">11.111.111-1</span></p></div><button type="button" class="secondary-button">← Volver a socios</button></div><section class="member-related" aria-label="Suscripciones del socio"><h3>Suscripciones <span class="muted-copy">(1)</span></h3><div class="table-wrap"><table><thead><tr><th>Canal</th><th>Estado</th><th>Monto de origen</th><th>Detalle</th></tr></thead><tbody><tr><td>VirtualPOS</td><td>Activa</td><td class="num">—</td><td><button class="record-link" type="button">Ver suscripción</button><details class="member-record-ids"><summary>Identificadores</summary><p>ID de origen: ext-s1<br>ID interno: S-1</p></details></td></tr></tbody></table></div></section><section class="member-related" aria-label="Cobros del socio"><h3>Cobros <span class="muted-copy">(1)</span></h3><div class="table-wrap"><table><thead><tr><th>Canal</th><th>Estado</th><th>Monto de origen</th><th>Detalle</th></tr></thead><tbody><tr><td>VirtualPOS</td><td>Pagado</td><td class="num">10.000</td><td><button class="record-link" type="button">Ver cobro</button><details class="member-record-ids"><summary>Identificadores</summary><p>ID de origen: ext-g1<br>ID interno: G-1</p></details></td></tr></tbody></table></div><p class="muted-copy">Esta ficha no informa la moneda de los importes.</p></section><section class="member-related" aria-label="Pagos del socio"><h3>Pagos <span class="muted-copy">(0)</span></h3><p class="muted-copy">Sin registros relacionados.</p></section><details class="member-record-ids"><summary>Identificadores de cliente por canal</summary><p>VirtualPOS: ext-c1 · ID interno: C-1</p></details></section></section><section class="etl-panel"><div class="etl-panel-heading"><div><p class="eyebrow">CONSOLIDACIÓN</p><h3>Base de datos unificada</h3></div><button class="sync-btn " aria-expanded="false">↻ Sync completo</button></div></section></main>"`;


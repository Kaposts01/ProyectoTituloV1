exports[`Clientes consolidados (/central/clientes) > la ficha general pide el detalle por RUT y permite volver 1`] = `"<main class="app-shell"><header class="topbar"><div class="brand"><span class="brand-mark">Sx</span><div><p class="eyebrow">OPERACIONES RECURRENTES</p><h1>SynkmetriX</h1></div></div><div class="sync-state ready"><span></span>Staging local</div></header><section class="hero-panel"><div><p class="eyebrow">RESUMEN OPERATIVO</p><h2>Operación consolidada,<br>desde todos los canales.</h2></div><p class="sync-copy">KPIs y actividad mensual calculados desde las entidades centralizadas y TCH.</p></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">CLIENTES CONSOLIDADOS</p><h3>250 clientes por RUT</h3></div></div><div class="filter-bar"><div class="filter-row"><div class="filter-fields"><label class="filter-field"><span>Buscar en</span><select aria-label="Campo de búsqueda de clientes"><option value="all">Todos los campos</option><option value="rut">RUT</option><option value="name">Nombre</option><option value="last_name">Apellido</option><option value="platform">Plataforma</option><option value="email">Correo</option><option value="phone">Teléfono</option></select></label><label class="filter-field filter-field-wide"><span>Texto</span><input aria-label="Buscar cliente consolidado" placeholder="Buscar clientes" type="search" value=""></label><label class="filter-field"><span>Canal</span><select aria-label="Canal de los socios"><option value="">Todos los canales</option><option value="virtualpos">VirtualPOS</option><option value="toku">Toku</option><option value="payku">Payku</option><option value="tch">TCH</option></select></label><label class="filter-field"><span>Estado</span><select aria-label="Estado de los socios"><option value="">Todos</option><option value="active">Con suscripción activa</option><option value="inactive">Sin suscripción activa</option></select></label></div><div class="filter-actions"><div class="export-button"><button type="button" class="export-trigger" aria-haspopup="menu" aria-expanded="false" aria-busy="false"><span aria-hidden="true">↓</span> Exportar</button><span class="export-status" role="status" aria-live="polite"></span></div></div></div><div class="filter-summary"><p class="filter-count" aria-live="polite"><span class="mono">250</span> socios</p></div></div><p class="muted-copy">Agrupado por RUT <strong>no verificado</strong>: el mismo RUT en dos canales se muestra como un solo socio, pero el CRM aún no confirma que sea la misma persona (identidad centralizada pendiente, UX-11).</p><div class="record-detail"><button>← Volver a clientes</button><h3>Ficha general: 11111111-1</h3><div><h4>IDs de cliente</h4><div class="table-wrap"><table><thead><tr><th>Portal</th><th>ID interno</th><th>ID origen</th><th>Estado</th><th>Monto</th></tr></thead><tbody><tr><td>VirtualPOS</td><td>C-1</td><td>ext-c1</td><td>—</td><td>—</td></tr></tbody></table></div></div><div><h4>Suscripciones</h4><div class="table-wrap"><table><thead><tr><th>Portal</th><th>ID interno</th><th>ID origen</th><th>Estado</th><th>Monto</th></tr></thead><tbody><tr><td>VirtualPOS</td><td>S-1</td><td>ext-s1</td><td>Activa</td><td>—</td></tr></tbody></table></div></div><div><h4>Cargos</h4><div class="table-wrap"><table><thead><tr><th>Portal</th><th>ID interno</th><th>ID origen</th><th>Estado</th><th>Monto</th></tr></thead><tbody><tr><td>VirtualPOS</td><td>G-1</td><td>ext-g1</td><td>Pagado</td><td>$10.000</td></tr></tbody></table></div></div><div><h4>Transacciones</h4><div class="table-wrap"><table><thead><tr><th>Portal</th><th>ID interno</th><th>ID origen</th><th>Estado</th><th>Monto</th></tr></thead><tbody><tr><td colspan="5">Sin registros relacionados.</td></tr></tbody></table></div></div></div></section><section class="etl-panel"><div class="etl-panel-heading"><div><p class="eyebrow">CONSOLIDACIÓN</p><h3>Base de datos unificada</h3></div><button class="sync-btn ">↻ Sync completo</button></div></section></main>"`;


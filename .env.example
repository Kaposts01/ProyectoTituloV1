# Application
APP_NAME=CRM Suscripciones
APP_ENV=development
DEBUG=true
AUTH_JWT_SECRET=replace_with_a_random_32_byte_secret
AUTH_ACCESS_TOKEN_MINUTES=60
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=kapo
POSTGRES_PASSWORD=replace_with_a_local_postgres_password
DATABASE_URL=postgresql+psycopg://kapo:replace_with_a_local_postgres_password@localhost:5433/crm

# VirtualPOS Sandbox. Do not commit real values to this file.
VIRTUALPOS_BASE_URL=https://sandbox.example.virtualpos.com
VIRTUALPOS_API_KEY=replace_with_sandbox_api_key
VIRTUALPOS_SECRET_KEY=replace_with_sandbox_secret_key
VIRTUALPOS_TIMEOUT_SECONDS=120
VIRTUALPOS_READ_RETRIES=2
VIRTUALPOS_WRITES_ENABLED=false
VIRTUALPOS2_BASE_URL=https://example.virtualpos.com
VIRTUALPOS2_API_KEY=replace_with_virtualpos2_api_key
VIRTUALPOS2_SECRET_KEY=replace_with_virtualpos2_secret_key

# Toku API
TOKU_BASE_URL=https://api.trytoku.com
TOKU_API_KEY=replace_with_toku_api_key
TOKU_ACCOUNT_KEY=replace_with_toku_account_key
TOKU_TIMEOUT_SECONDS=120
TOKU_READ_RETRIES=2
TOKU_WRITES_ENABLED=false

# Payku API. Use the public token without the "Bearer " prefix.
PAYKU_BASE_URL=https://app.payku.cl
PAYKU_API_KEY=replace_with_payku_api_key
PAYKU_SECRET_KEY=replace_with_payku_secret_key
PAYKU_PUBLIC_TOKEN=replace_with_payku_public_token
PAYKU_PRIVATE_TOKEN=replace_with_payku_private_token
PAYKU_DATE_INIT=2020-08-04
PAYKU_DATE_END=
PAYKU_TIMEOUT_SECONDS=120
PAYKU_READ_RETRIES=2
PAYKU_WRITES_ENABLED=false

# ---------------------------------------------------------------------------
# AMBIENTE SANDBOX / QA (opcional). Produccion no necesita nada de esto.
# Copie este bloque a un archivo `.env.sandbox` (o `.env.qa`; no se versionan: agregue `.env.*` a .gitignore, con excepcion de .env.example)
# y arranque con APP_ENV=sandbox (ver comandos en el reporte).
# `.env.sandbox` se carga ENCIMA de `.env`: liste TODAS las variables de abajo, aunque
# queden vacias (vacio = canal deshabilitado, nunca cae a produccion).
# La app no arranca si en sandbox/qa una URL apunta a produccion, o en production a sandbox.
# ---------------------------------------------------------------------------
# APP_ENV=sandbox
# Base de datos separada: el NOMBRE debe contener "sandbox" (o "qa").
# DATABASE_URL=postgresql+psycopg://kapo:CLAVE@localhost:5433/crm_sandbox
# AUTH_JWT_SECRET=  (use uno distinto al de produccion)
#
# VirtualPOS cuentas 1 y 2: llaves de sandbox en https://comercios.virtualpos-sandbox.com
#   (Perfil > Configuracion de cuenta > Integracion). URL documentada:
#   https://api.virtualpos-sandbox.com  (docs/integrations/virtualpos/resources/sandbox.md:5)
# VIRTUALPOS_BASE_URL=
# VIRTUALPOS_API_KEY=
# VIRTUALPOS_SECRET_KEY=
# VIRTUALPOS_WRITES_ENABLED=false
# VIRTUALPOS2_BASE_URL=
# VIRTUALPOS2_API_KEY=
# VIRTUALPOS2_SECRET_KEY=
#
# Toku: NO existe sandbox documentado (docs/integrations/toku/resources/authentication.md:64-65).
#   Dejar vacio = Toku deshabilitado en sandbox. Solo llenar si Toku entrega un ambiente de prueba.
# TOKU_BASE_URL=
# TOKU_API_KEY=
# TOKU_ACCOUNT_KEY=
# TOKU_WRITES_ENABLED=false
#
# Payku: host de pruebas visto solo en la coleccion Postman (https://des.payku.cl,
#   docs/integrations/payku/resources/postman.md:235); no esta confirmado como sandbox oficial.
#   Tokens de prueba: panel Payku de pruebas. Si no los tiene, deje vacio (canal deshabilitado).
# PAYKU_BASE_URL=
# PAYKU_API_KEY=
# PAYKU_SECRET_KEY=
# PAYKU_PUBLIC_TOKEN=
# PAYKU_PRIVATE_TOKEN=
# PAYKU_WRITES_ENABLED=false

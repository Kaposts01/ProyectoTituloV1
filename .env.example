# Application
APP_NAME=CRM Suscripciones
APP_ENV=development
DEBUG=true

# PostgreSQL (Docker Compose defaults)
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5433/crm

# VirtualPOS Sandbox. Do not commit real values to this file.
VIRTUALPOS_BASE_URL=https://sandbox.example.virtualpos.com
VIRTUALPOS_API_KEY=replace_with_sandbox_api_key
VIRTUALPOS_SECRET_KEY=replace_with_sandbox_secret_key
VIRTUALPOS_TIMEOUT_SECONDS=30

# Toku Sandbox
TOKU_BASE_URL=https://api.sandbox.toku.com
TOKU_API_KEY=replace_with_toku_api_key
TOKU_TIMEOUT_SECONDS=30

# Payku API. Use the public token without the "Bearer " prefix.
PAYKU_BASE_URL=https://app.payku.cl
PAYKU_API_KEY=replace_with_payku_api_key
PAYKU_SECRET_KEY=replace_with_payku_secret_key
PAYKU_TIMEOUT_SECONDS=30

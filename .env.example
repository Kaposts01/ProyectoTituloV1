# Application
APP_NAME=CRM Suscripciones
APP_ENV=development
DEBUG=true
AUTH_JWT_SECRET=replace_with_a_random_32_byte_secret
AUTH_ACCESS_TOKEN_MINUTES=60
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=kapo
POSTGRES_PASSWORD=replace_with_a_local_postgres_password
DATABASE_URL=postgresql+psycopg://kapo:replace_with_a_local_postgres_password@localhost:5433/crm

# VirtualPOS Sandbox. Do not commit real values to this file.
VIRTUALPOS_BASE_URL=https://sandbox.example.virtualpos.com
VIRTUALPOS_API_KEY=replace_with_sandbox_api_key
VIRTUALPOS_SECRET_KEY=replace_with_sandbox_secret_key
VIRTUALPOS_TIMEOUT_SECONDS=120
VIRTUALPOS_READ_RETRIES=2
VIRTUALPOS_WRITES_ENABLED=false
# Solo activar para la prueba V-5 en sandbox (POST /v3/charge con MONTO_FIJO, E-113)
# VIRTUALPOS_ALLOW_CHARGE_ON_FIXED_PLAN=false
VIRTUALPOS2_BASE_URL=https://example.virtualpos.com
VIRTUALPOS2_API_KEY=replace_with_virtualpos2_api_key
VIRTUALPOS2_SECRET_KEY=replace_with_virtualpos2_secret_key

# Toku API
TOKU_BASE_URL=https://api.trytoku.com
TOKU_API_KEY=replace_with_toku_api_key
TOKU_ACCOUNT_KEY=replace_with_toku_account_key
TOKU_TIMEOUT_SECONDS=120
TOKU_READ_RETRIES=2
TOKU_WRITES_ENABLED=false
# Pepper del HMAC de `ID Producto` en el importador de reportes de Toku (contiene el RUT del socio).
# NO versionar el valor real. Cambiarlo invalida la correlacion con los hashes ya guardados.
# Vacio = el importador se niega a cargar (falla cerrada).
# TOKU_REPORT_HASH_PEPPER=
# Pepper del HMAC del codigo de vendedor (tiene forma de RUT) en el importador de reportes PAT de VirtualPOS.
# NO versionar el valor real. Vacio = el importador carga igual pero no guarda el hash del vendedor.
# VP_REPORT_HASH_PEPPER=

# Payku API. Use the public token without the "Bearer " prefix.
PAYKU_BASE_URL=https://app.payku.cl
PAYKU_API_KEY=replace_with_payku_api_key
PAYKU_SECRET_KEY=replace_with_payku_secret_key
PAYKU_PUBLIC_TOKEN=replace_with_payku_public_token
PAYKU_PRIVATE_TOKEN=replace_with_payku_private_token
PAYKU_DATE_INIT=2020-08-04
PAYKU_DATE_END=
PAYKU_TIMEOUT_SECONDS=120
PAYKU_READ_RETRIES=2
PAYKU_WRITES_ENABLED=false

# ---------------------------------------------------------------------------
# AMBIENTE SANDBOX / QA (un solo .env). Estas variables se usan SOLO con APP_ENV=sandbox;
# con produccion se ignoran. Con sandbox, la app toma unicamente las *_SANDBOX_*
# (reemplazo, nunca cae a las de produccion). Canal sin variables sandbox = deshabilitado.
# Activar en PowerShell, antes de alembic y uvicorn (tiene prioridad sobre APP_ENV del .env):
#   $env:APP_ENV='sandbox'
# El backend sandbox usa la BD de SANDBOX_DATABASE_URL (su nombre debe contener sandbox o qa
# y ser distinta de DATABASE_URL).
# Las llaves de sandbox deben ser DISTINTAS de las de produccion (la app no arranca si coinciden).
# ---------------------------------------------------------------------------
SANDBOX_DATABASE_URL=

# VirtualPOS sandbox (https://api.virtualpos-sandbox.com). En sandbox solo existe la cuenta 1.
VIRTUALPOS_SANDBOX_BASE_URL=
VIRTUALPOS_SANDBOX_API_KEY=
VIRTUALPOS_SANDBOX_SECRET_KEY=
VIRTUALPOS_SANDBOX_WRITES_ENABLED=false

# Toku sandbox: misma URL que produccion (https://api.trytoku.com); se distingue solo por llaves de prueba.
TOKU_BASE_SANDBOX_URL=
TOKU_SANDBOX_API_KEY=
TOKU_SANDBOX_ACCOUNT_KEY=
TOKU_SANDBOX_WRITES_ENABLED=false
# Guardas duras de escritura de Toku en sandbox/qa (app/integrations/toku/write_guard.py).
# Las 3 siguientes son variables de PROCESO (se exportan en la sesion que hace la prueba y se retiran al
# terminar). NO las dejes encendidas en este archivo: el codigo solo las lee de os.environ, y tenerlas aqui
# invita a dejar el sandbox armado.
#   TOKU_SANDBOX_ALLOW_WRITES_ARMED=1   segunda llave (ademas de TOKU_SANDBOX_WRITES_ENABLED=true)
#   TOKU_SANDBOX_ALLOWED_IDS=           IDs (separados por coma) sin prefijo TEST- que se pueden modificar/borrar
#   TOKU_SANDBOX_MAX_WRITES=25          tope de escrituras por proceso (default 25)

# Payku sandbox (aun no activado por soporte). No puede ser https://app.payku.cl.
PAYKU_SANDBOX_BASE_URL=
PAYKU_SANDBOX_PUBLIC_TOKEN=
PAYKU_SANDBOX_PRIVATE_TOKEN=
PAYKU_SANDBOX_WRITES_ENABLED=false

# SELECTOR DE AMBIENTE (dos instancias independientes; el selector solo navega a la otra URL).
# Produccion: puerto 8000 (por defecto). Sandbox: scripts/run_sandbox_backend.ps1 (APP_ENV=sandbox, puerto 8001).
# Cada instancia tiene su login y cookie propios (en sandbox/qa la cookie lleva sufijo _sandbox/_qa).
# URL de la instancia sandbox, usada desde produccion (http/https).
SANDBOX_APP_URL=
# URL de produccion, usada desde sandbox/qa (http/https).
PRODUCTION_APP_URL=
# Scheduler en sandbox/qa: apagado por defecto; true para activarlo. En produccion se ignora.
SANDBOX_SCHEDULER_ENABLED=false
# Horas tras las cuales una sincronizacion/ETL `running` se considera abandonada y deja de bloquear (default 6).
SYNC_RUN_STALE_HOURS=6
# La corrida nocturna consolida TCH solo si llego un reporte Excel nuevo (false = siempre).
SYNC_TCH_CONSOLIDATE_ONLY_AFTER_LOAD=true
# El ETL Core (Toku/Payku/VirtualPOS) corre dentro del sync nocturno tras consolidar (false = solo manual).
# Apagado por defecto: se enciende despues de una primera corrida manual y un respaldo de la base.
SYNC_CORE_ETL_ENABLED=false
# RJ-06: captura diaria de la glosa de rechazo de VirtualPOS (1 peticion por suscripcion con rechazos sin detalle).
# Requiere la migracion 20261029_0043. Apagada por defecto: se enciende tras revisar. Tope por corrida y por cuenta.
VP_REJECTION_CAPTURE_ENABLED=false
VP_REJECTION_CAPTURE_MAX_SUBSCRIPTIONS=500
# RJ-15: materializa los intentos FAILED de Toku como core_payments (source_status='FAILED'). Apagada por defecto.
TOKU_MATERIALIZE_FAILED_PAYMENTS=false
# TK-20: señales de suscripcion de Toku desde los reportes cargados (activa efectiva, racha por cuotas, tarjeta bloqueada o
# vencida) y estado reporte > API en core. Apagada por defecto. Dias sin intento para que una cuota fallida quede «en firme».
TOKU_REPORT_SIGNALS_ENABLED=false
TOKU_REPORT_FIRM_UNPAID_DAYS=7

# RT-04..08: webhooks en tiempo casi real (ver docs/data/webhooks.md). Los secretos van SOLO en el .env real, nunca aqui.
# Vacio = el receptor responde 503. El de Toku (whesec_...) se obtiene al crear el endpoint en Toku.
TOKU_WEBHOOK_SECRET=
PAYKU_WEBHOOK_SECRET=
VIRTUALPOS_PAYOUT_WEBHOOK_SECRET=
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Solo detras de un proxy/tunel propio: confiar en X-Forwarded-For para el rate limit.
WEBHOOK_TRUST_FORWARDED_FOR=false
# Procesador de la cola webhook_events (job cada minuto). Apagado por defecto: sin la bandera la cola solo acumula.
WEBHOOK_PROCESSOR_ENABLED=false
# RT-06: reconciliacion dirigida cada 3 h (07-22). Apagada por defecto.
TARGETED_RECONCILE_ENABLED=false
TARGETED_RECONCILE_MAX_PER_RUN=200

# SYNC-D-08: alertas de sincronizacion por correo (docs/data/alerts.md). Apagadas por defecto. Los valores reales van SOLO en
# el .env real, nunca aqui. ALERT_EMAIL_TO es obligatorio (lista separada por comas); sin el no se envia nada.
ALERTS_ENABLED=false
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_STARTTLS=true

# VP-PAR-11: paridad diaria (06:40) reportes PAT importados vs base, solo lectura, resultado al log. Apagada por defecto.
VP_PARITY_CHECK_ENABLED=false

# BILL-09 (GB-JB-20): allowlist del piloto de la Opcion A (cambios de cobro VirtualPOS). Lista separada por comas de
# plataforma:suscripcion (p. ej. virtualpos1:sub_123,virtualpos1:sub_456); un id sin plataforma cuenta como virtualpos1.
# VACIA = ninguna suscripcion admite solicitudes, aprobaciones, aplicacion ni chequeo de renovacion.
BILLING_PILOT_ALLOWLIST=
# BILL-10: controles diarios de consistencia de la Opcion A (GB-CS-02..14, 03:30), solo lectura, resultado al log.
# Apagada por defecto.
BILLING_CONSISTENCY_CHECK_ENABLED=false

# ADVERTENCIA: guarda anti-downgrade de Alembic (alembic/env.py). Solo se permite bajar version en bases
# *_test, *sandbox* o *qa*. Para forzarlo en otra base (p. ej. crm), definir esta variable en el PROCESO
# (nunca en el .env real) SOLO para ese comando y quitarla despues. NO dejarla encendida.
# ALEMBIC_ALLOW_DOWNGRADE=1

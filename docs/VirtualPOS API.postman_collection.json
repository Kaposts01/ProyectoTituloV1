  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const CryptoJS = require('crypto-js');\r",
          "\r",
          "const apiKey    = pm.environment.get('api_key');\r",
          "const secretKey = pm.environment.get('secret_key');\r",
          "\r",
          "function base64url(source) {\r",
          "    let encoded = CryptoJS.enc.Base64.stringify(source);\r",
          "    encoded = encoded.replace(/=+$/, '');\r",
          "    encoded = encoded.replace(/\\+/g, '-');\r",
          "    encoded = encoded.replace(/\\//g, '_');\r",
          "    return encoded;\r",
          "}\r",
          "\r",
          "const header  = { alg: 'HS256', typ: 'JWT' };\r",
          "const encodedHeader = base64url(\r",
          "    CryptoJS.enc.Utf8.parse(JSON.stringify(header))\r",
          ");\r",
          "\r",
          "const payload = { api_key: apiKey };\r",
          "const encodedPayload = base64url(\r",
          "    CryptoJS.enc.Utf8.parse(JSON.stringify(payload))\r",
          ");\r",
          "\r",
          "const token     = `${encodedHeader}.${encodedPayload}`;\r",
          "const signature = CryptoJS.HmacSHA256(token, secretKey);\r",
          "const encodedSignature = base64url(signature);\r",
          "\r",
          "const jwt = `${token}.${encodedSignature}`;\r",
          "pm.request.headers.add({key: 'Signature', value: jwt});\r",
          "\r",
          "console.log('✅ JWT Agregado');"
        ]
      }
    },
